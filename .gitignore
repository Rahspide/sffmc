node_modules/
dist/
*.bak-pre-*
.DS_Store
*.log
coverage/
.vscode/
.opencode/
.mimocode/
.idea/
.env
.env.local
.sffmc/
dependencies/
# Ignore auto-generated codemap files (maintained by codemap tool)
**/codemap.md
.codegraph/
# Ignore .slim/* runtime files
.slim/*
# BEGIN oh-my-opencode-slim clonedeps
# (cloned source repos — gitignored)
.slim/clonedeps/repos/
# (the structured manifest is reviewable project metadata and IS tracked)
!.slim/clonedeps.json
# END oh-my-opencode-slim clonedeps

# Internal process artifacts (move to ~/.superpowers/sdd/<project>/)
/docs/superpowers/
/pr-review-*
/*-security-audit.md
/security-audit-*.md
/audit-report-*.md

# Session handoffs and agent state-archive (not tracked)
/state-archive/
/*handoff*.md
/*HANDOFF*.md
/NEW-CHAT-PROMPT.md

# Release-process scratch (patterns, agents, drafts) -- never tracked.
# The umbrella `.sffmc/` line above already covers these; explicit
# entries document intent for reviewers reading .gitignore.
/.sffmc/patterns/
/.sffmc/agents/
/.sffmc/releases/
/.sffmc/workflows/

# Regenerable local graph/knowledge-graph caches -- not source, rebuilt on
# demand (`graft build`, `graphify update .`). The interactive viewer at
# graphify-out/graph.html stays usable locally; it just never enters git.
graft/
graphify-out/

# tools/mint -- standalone Go module (module github.com/Rahspide/sffmc/tools/mint),
# first-party but NOT part of the SFFMC bun workspace or CI build. Untracked
# on purpose pending a decision: commit it here, or split it into its own repo
# (its design doc argues for the split). `bin/` holds compiled binaries and
# must never be tracked either way.
/tools/mint/
